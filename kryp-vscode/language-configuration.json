{
    "comments": { "lineComment": "--" },
    "brackets": [["(", ")"], ["[", "]"]],
    "autoClosingPairs": [
      { "open": "\"", "close": "\"" },
      { "open": "(", "close": ")" },
      { "open": "[", "close": "]" },
      { "open": "var:{", "close": "}" }
    ],
    "surroundingPairs": [
      ["\"", "\""],
      ["(", ")"],
      ["[", "]"]
    ],
    "indentationRules": {
      "increaseIndentPattern": "=>\\s*$",
      "decreaseIndentPattern": "^\\s*(else|catch)\\b"
    },
    "folding": { "markers": { "start": "=>", "end": "^\\S" } }
  }